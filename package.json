{
  "name": "bliss-nature-trails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "format": "prettier --write src server/*.js shared scripts tests vite.config.js index.html README.md",
    "start": "node server/index.js",
    "assets": "node scripts/prepare-assets.js",
    "db:setup": "node server/setup.js",
    "admin:create": "node server/create-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.1",
    "sharp": "^0.34.3",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.8",
    "supertest": "^7.1.4",
    "vite": "^7.1.5"
  }
}
